# QEMU WebAssembly browser acceptance environment.
#
# SPDX-License-Identifier: GPL-2.0-or-later

FROM docker.io/library/node:22-bookworm-slim@sha256:53ada149d435c38b14476cb57e4a7da73c15595aba79bd6971b547ceb6d018bf

RUN export DEBIAN_FRONTEND=noninteractive && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        chromium-sandbox && \
    rm -rf /var/lib/apt/lists/*

ENV QEMU_WASM_CHROMIUM_EXECUTABLE=/usr/bin/chromium

USER node
WORKDIR /workspace

CMD ["chromium", "--version"]
